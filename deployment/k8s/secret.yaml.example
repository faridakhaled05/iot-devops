apiVersion: v1
kind: Secret
metadata:
  name: sensorix-secrets
type: Opaque
stringData:
  db-password: "REPLACE_WITH_YOUR_MYSQL_ROOT_PASSWORD"
  jwt-secret: "REPLACE_WITH_YOUR_JWT_SECRET_MIN_32_CHARS"
  r2-account-id: "REPLACE_WITH_YOUR_CLOUDFLARE_ACCOUNT_ID"
  r2-bucket: "REPLACE_WITH_YOUR_R2_BUCKET_NAME"
  r2-access-key-id: "REPLACE_WITH_YOUR_R2_ACCESS_KEY_ID"
  r2-secret-access-key: "REPLACE_WITH_YOUR_R2_SECRET_ACCESS_KEY"
  r2-public-base-url: "https://cdn.example.com"
