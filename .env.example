# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Docker Hub
DOCKER_USERNAME=your_dockerhub_username
IMAGE_TAG=v3.0

# Secrets path for local manual runs
# Point this to the folder containing db_password.txt and jwt_secret.txt
SECRETS_PATH=./secrets

# DB and JWT secrets are managed as Docker secret files — not env vars
# For local manual runs, create:
#   secrets/db_password.txt  ← MySQL root password
#   secrets/jwt_secret.txt   ← JWT signing key
# For CI/CD, these are injected by Jenkins credentials store
